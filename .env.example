# Copy to .env and adjust for your local environment. All values shown are
# defaults or placeholders; do not commit real secrets here.

# Directories containing the managed Terraform root module / Ansible assets.
IAC_TERRAFORM_DIR=terraform
IAC_ANSIBLE_DIR=ansible

# Default environment used when a CLI command omits --env.
IAC_DEFAULT_ENVIRONMENT=dev

# Comma-separated allow-list is not supported directly; this is illustrative
# of the Settings.environments default (dev, staging, prod).
# IAC_ENVIRONMENTS=dev,staging,prod

# Terraform remote state backend.
IAC_BACKEND_TYPE=s3
IAC_BACKEND_BUCKET=REPLACE_WITH_STATE_BUCKET
IAC_BACKEND_REGION=us-east-1

# Executables (override if not on PATH).
IAC_TERRAFORM_BINARY=terraform
IAC_ANSIBLE_BINARY=ansible-playbook

# Logging.
IAC_LOG_LEVEL=INFO
